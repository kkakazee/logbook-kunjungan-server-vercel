# Salin file ini menjadi `.env` (untuk lokal) atau isi di
# Vercel → Project → Settings → Environment Variables (untuk produksi).
# JANGAN pernah commit file .env asli ke Git.

# ===== Database (Aiven MySQL → Service → Overview → Connection information) =====
DB_HOST=mysql-xxxxxx-namaproject.d.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=isi-password-aiven
DB_NAME=defaultdb

# Isi dengan SELURUH isi file "CA certificate" (ca.pem) dari Aiven, termasuk
# baris -----BEGIN CERTIFICATE----- dan -----END CERTIFICATE-----.
# Di Vercel boleh ditempel apa adanya (multi-baris). Di file .env lokal,
# tulis dalam satu baris dengan \n sebagai pengganti baris baru, atau
# pakai DB_CA_CERT_PATH=./ca.pem.
DB_CA_CERT=
# DB_CA_CERT_PATH=./ca.pem

# ===== Autentikasi =====
# Minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ===== Opsional =====
# Origin tambahan yang boleh memanggil API (pisahkan dengan koma).
# Kosongkan jika frontend & API di domain yang sama (default di Vercel).
# ALLOWED_ORIGINS=https://logbook.contoh.id

# Verifikasi lokasi di sisi server untuk Form Masuk/Keluar.
# Isi LOKASI_LAT & LOKASI_LNG untuk mengaktifkan.
LOKASI_LAT=-6.3026346
LOKASI_LNG=106.75639
LOKASI_RADIUS_METER=200

# Matikan cek lokasi SEMENTARA (uji coba dari luar kantor).
# Isi KEDUANYA dengan false; di Vercel lakukan redeploy setelah mengubah
# VITE_LOKASI_AKTIF karena nilainya dibaca saat build.
# LOKASI_AKTIF=false
# VITE_LOKASI_AKTIF=false

# Port untuk `npm run dev` / `npm start` (tidak dipakai di Vercel)
PORT=3001
