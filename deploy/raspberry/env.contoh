# Salin menjadi .env di folder utama logbook:  cp deploy/raspberry/env.contoh .env
# Lalu ganti semua nilai GANTI_... (lihat PANDUAN-RASPBERRY.md bagian 4).

# Folder penyimpanan data MySQL & backup (sebaiknya di disk USB, bukan microSD)
LOGBOOK_DATA_DIR=/mnt/data/logbook

# Database (dibuat otomatis oleh container MySQL saat pertama jalan)
DB_NAME=logbook
DB_USER=logbook
DB_PASSWORD=GANTI_PASSWORD_DB
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT

# Kunci sesi login (acak, minimal 32 karakter)
JWT_SECRET=GANTI_KUNCI_ACAK

# Cek lokasi tamu (radius dari kantor). false = dimatikan sementara.
LOKASI_LAT=-6.3026346
LOKASI_LNG=106.75639
LOKASI_RADIUS_METER=200
LOKASI_AKTIF=false
VITE_LOKASI_AKTIF=false

# Cloudflare Tunnel — diisi di bagian 8 panduan
TUNNEL_TOKEN=
# Hapus tanda # di bawah setelah TUNNEL_TOKEN diisi
# COMPOSE_PROFILES=tunnel
